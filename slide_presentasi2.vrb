        \centering
        \scriptsize
        \begin{tabularx}{\textwidth}{@{} >{\raggedright\arraybackslash}p{2.5cm} X X @{}}
            \toprule
            \textbf{Dimensi} & \textbf{SOP Konvensional} & \textbf{SOP Digital Terintegrasi} \\
            \midrule
            \textbf{Fokus Ekosistem} & Interaksi fisik antar-manusia. & Orkestrasi sistem dan manusia. \\
            \textbf{Inisiator Proses} & Inisiatif manual oleh staf. & \textbf{System-Event Trigger} otomatis. \\
            \textbf{Validasi Naskah} & Tanda tangan basah \& stempel. & \textbf{Audit Trail} \& \textbf{TTE}. \\
            \textbf{Mgt. Risiko} & Reaktif, bergantung daya ingat. & Preventif, \textit{immutable} \& \textit{real-time}. \\
